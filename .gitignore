# Build and package output. Keep Cargo.lock for reproducible development checks.
/target/
/target-*/
/dist/
/release-artifacts/
**/*.rs.bk
*.pdb
*.dSYM/

# Local measurements and scratch output; curated docs/validation data is versioned.
/.abba*/
/abba-*/
/criterion/
/artifacts/
/tmp/
/logs/
/*.log
**/mutants.out*/
*.profraw
*.profdata

# Editor and operating-system state
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python tooling caches
__pycache__/
*.py[cod]

# Coverage and profiler output
/coverage/
*.lcov
lcov.info
/flamegraph*.svg
/perf.data*

# Local environment settings; example configuration may be committed.
.env
.env.*
!.env.example
!.env.sample

# Local assistant state; AGENTS.md remains versioned contributor guidance.
.claude/
.codex/
.agents/
docs/plans
